# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Supervisor phone number(s) for SMS alerts (comma-separated, 10-digit Indian numbers are fine)
COPS_SMS_TO=

# SMS provider: fill in ONE of these to send real SMS (otherwise alerts are "simulated")
# Fast2SMS (India): https://www.fast2sms.com -> Dev API -> API key
FAST2SMS_API_KEY=
# Twilio: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp alerts (high-risk SOS, emergency stop, idle/no-work, critical faults). Fill in ONE:
# CallMeBot (free): from the supervisor's WhatsApp, send "I allow callmebot to send me messages"
# to the CallMeBot number listed on https://www.callmebot.com/blog/free-api-whatsapp-messages/ -> you get an apikey
CALLMEBOT_API_KEY=
# Twilio WhatsApp (sandbox sender is usually whatsapp:+14155238886; uses the Twilio SID/token above)
TWILIO_WHATSAPP_FROM=
# Optional: a different WhatsApp number than COPS_SMS_TO
# COPS_WHATSAPP_TO=

# Idle / no-work alert threshold in seconds (demo 60; a real site might use 600)
COPS_IDLE_ALERT_S=60

# Optional: Claude for the ASK COPS assistant
# ANTHROPIC_API_KEY=
